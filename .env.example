# ─── App ───────────────────────────────────────────────────────────────────
APP_ENV=local                      # local | test | staging | production
APP_NAME=turkish-rag
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── RabbitMQ / Celery ─────────────────────────────────────────────────────
RABBITMQ_USER=rag
RABBITMQ_PASSWORD=rag
CELERY_BROKER_URL=amqp://rag:rag@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Object storage (MinIO / S3) ───────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio123
STORAGE_BUCKET=documents

# ─── Auth / JWT (RS256) ─────────────────────────────────────────────────────
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then paste the PEM contents (newlines as \n) or mount as files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# ─── AI / RAG ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyDk6wJd2mzT2hUZNMf8Qy1bU8HoRowX7oE
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OCR_ENGINE=paddle                  # paddle | tesseract
EMBEDDING_DIM=1024
RETRIEVAL_TOP_K=50
RERANK_TOP_N=8

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_RAG_PER_MINUTE=30

# ─── Uploads ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,image/png,image/jpeg
