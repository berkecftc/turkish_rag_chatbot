{
  "title": "Turkish RAG — Platform Overview",
  "uid": "rag-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "API request rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total[5m])) by (handler)", "legendFormat": "{{handler}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "API latency p50 / p95 / p99",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "API 5xx error rate",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1e-9)", "legendFormat": "5xx ratio" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "RAG chat latency p95 (stream + sync)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=~\".*rag/chat.*\"}[5m])) by (le, handler))", "legendFormat": "{{handler}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Ingestion queue depth (RabbitMQ ready)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages_ready) by (queue)", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Celery tasks: success vs failure (15m)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum(increase(celery_task_succeeded_total[15m]))", "legendFormat": "succeeded" },
        { "expr": "sum(increase(celery_task_failed_total[15m]))", "legendFormat": "failed" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "PostgreSQL connections",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum(pg_stat_activity_count)", "legendFormat": "active" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Redis memory (semantic cache)",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "used" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Host CPU / memory",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } },
      "targets": [
        { "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "cpu" },
        { "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "memory" }
      ]
    },
    {
      "id": 10, "type": "logs", "title": "API errors (Loki)",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": null },
      "targets": [{ "expr": "{service=\"api\"} | json | level=~\"error|warning\"" }]
    }
  ]
}
