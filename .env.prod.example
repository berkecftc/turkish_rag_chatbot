# ── Production environment template ─────────────────────────────────────────
# Copy to .env.prod and fill in. NEVER commit .env.prod.
# Generate strong secrets:  openssl rand -base64 32
# Generate JWT RSA keypair:
#   openssl genrsa -out jwt.pem 2048
#   openssl rsa -in jwt.pem -pubout -out jwt.pub
#   (paste single-line with \n escapes, or use $(cat jwt.pem) in deploy tooling)

# ── Public URL (used for CORS + Grafana root) ────────────────────────────────
PUBLIC_ORIGIN=https://example.com
DOMAIN=example.com

# ── Images (set by CI on deploy; local build fallback if unset) ──────────────
BACKEND_IMAGE=ghcr.io/OWNER/turkish-rag-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/turkish-rag-frontend:latest

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=rag

# ── Cache / queue ────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG
RABBITMQ_USER=rag
RABBITMQ_PASSWORD=CHANGE_ME_STRONG

# ── Object storage ───────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
STORAGE_BUCKET=documents

# ── Auth / JWT (RS256 PEM; single-line with \n escapes supported) ────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=30m
# Only needed when LLM_PROVIDER=gemini:
GEMINI_API_KEY=

# ── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
